{
  "name": "roxy-parcel-delivery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Roxy parcel delivery — React, Node.js and SQLite",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check server/db.mjs && node --check server/domain.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  }
}
